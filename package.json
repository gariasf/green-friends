{
  "name": "green-friends",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "engines": {
    "node": ">=24.3"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "test": "jest",
    "lint": "expo lint app src scripts relay web",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "species:build": "node scripts/species/build.ts",
    "species:coverage": "node --env-file-if-exists=.env.local scripts/species/openplantbook-coverage.ts",
    "relay:test": "npm --prefix relay test",
    "relay:deploy": "npm --prefix relay run deploy",
    "web:test": "npm --prefix web test",
    "web:deploy": "npm --prefix web run deploy"
  },
  "jest": {
    "preset": "jest-expo",
    "globalSetup": "<rootDir>/src/test/timezone.js",
    "testMatch": [
      "<rootDir>/src/**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^expo-modules-core(/.*)?$": "<rootDir>/node_modules/expo/node_modules/expo-modules-core$1"
    }
  },
  "reanimated": {
    "staticFeatureFlags": {
      "IOS_SYNCHRONOUSLY_UPDATE_UI_PROPS": true
    }
  },
  "dependencies": {
    "@expo-google-fonts/nunito-sans": "^0.4.2",
    "@expo-google-fonts/young-serif": "^0.4.0",
    "@expo/ui": "~58.0.8",
    "drizzle-orm": "^0.45.3",
    "expo": "58.0.0-preview.8",
    "expo-constants": "~58.0.8",
    "expo-crypto": "~58.0.2",
    "expo-file-system": "~58.0.3",
    "expo-font": "~58.0.3",
    "expo-haptics": "~58.0.2",
    "expo-image-manipulator": "~58.0.9",
    "expo-image-picker": "~58.0.8",
    "expo-linking": "~58.0.8",
    "expo-notifications": "~58.0.8",
    "expo-router": "~58.0.9",
    "expo-secure-store": "~58.0.0",
    "expo-sharing": "~58.0.11",
    "expo-splash-screen": "~58.0.1",
    "expo-sqlite": "~58.0.6",
    "expo-symbols": "~58.0.2",
    "fflate": "^0.8.3",
    "phosphor-react-native": "^3.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0-rc.2",
    "react-native-reanimated": "4.7.0",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "~4.28.0",
    "react-native-svg": "15.15.5",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.3.0",
    "babel-plugin-inline-import": "^3.0.0",
    "babel-preset-expo": "~58.0.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~58.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "~29.7.0",
    "jest-expo": "~58.0.4",
    "prettier": "^3.9.8",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react-native": "$react-native",
    "expo-modules-core": {
      "react-native-worklets": "$react-native-worklets"
    }
  }
}
