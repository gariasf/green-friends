{
  "name": "green-friends",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "test": "jest",
    "lint": "expo lint app src scripts plugins relay web",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "species:build": "node scripts/species/build.ts",
    "species:coverage": "node --env-file-if-exists=.env.local scripts/species/openplantbook-coverage.ts",
    "relay:test": "npm --prefix relay test",
    "relay:deploy": "npm --prefix relay run deploy",
    "web:test": "npm --prefix web test",
    "web:deploy": "npm --prefix web run deploy"
  },
  "jest": {
    "preset": "jest-expo",
    "globalSetup": "<rootDir>/src/test/timezone.js",
    "testMatch": [
      "<rootDir>/src/**/*.test.ts"
    ]
  },
  "dependencies": {
    "@expo-google-fonts/nunito-sans": "^0.4.2",
    "@expo/ui": "~57.0.20",
    "drizzle-orm": "^0.45.3",
    "expo": "~57.0.24",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image-manipulator": "~57.0.19",
    "expo-image-picker": "~57.0.19",
    "expo-linking": "~57.0.10",
    "expo-notifications": "~57.0.20",
    "expo-router": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.21",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-symbols": "~57.0.3",
    "fflate": "^0.8.3",
    "phosphor-react-native": "^3.0.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "babel-plugin-inline-import": "^3.0.0",
    "babel-preset-expo": "~57.0.12",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.9.8",
    "typescript": "~6.0.3"
  }
}
